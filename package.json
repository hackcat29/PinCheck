{
  "name": "pincheck",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "test:live": "node --test \"smoke/*.test.mjs\"",
    "start": "node server.mjs",
    "check": "node cli.mjs",
    "vendor": "node scripts/vendor.mjs",
    "netlists": "node scripts/record-netlists.mjs",
    "build": "node scripts/build-site.mjs",
    "dev:worker": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "4.164.0"
  }
}
